INSERT INTO ubicacion (calle_nombre, calle_altura, calle_cruce, id_barrio, id_codigo_postal, longitud, latitud)
SELECT DISTINCT o.calle_nombre, o.calle_altura, o.calle_cruce, b.id_barrio, c.id_codigo_postal, o.`long`, o.lat
FROM oferta_gastronomica o
JOIN barrio b ON b.id_barrio = o.barrio 
JOIN codigo_postal c ON c.ccodigo_postal = o.codigo_postal;


INSERT DATOS CONTACT
INSERT INTO datos_contacto (id_local, tipo_contacto, valor) SELECT 
l.id_local, 
'telefono' AS tipo_contacto, 
o.telefono AS valor
FROM ofertagastronomica o
JOIN locall l ON l.nombre = o.nombre
WHERE o.telefono IS NOT NULL AND o.telefono != '';


INSERT INTO datos_contacto (id_local, tipo_contacto, valor)
SELECT 
    l.id_local, 
    'mail' AS tipo_contacto, 
    o.mail AS valor
FROM ofertagastronomica o
JOIN locall l ON l.nombre = o.nombre
WHERE o.mail IS NOT NULL AND o.mail != '';

INSERT INTO locall (nombre, horario, id_categoria, id_cocina, id_ambientacion, id_ubicacion)
SELECT 
    o.nombre, 
    o.horario, 
    c.id_categoria, 
    co.id_cocina, 
    a.id_ambientacion, 
    u.id_ubicacion
FROM ofertagastronomica o
LEFT JOIN categoria c ON c.nombre = o.categoria
LEFT JOIN cocina co ON co.tipo_cocina = o.cocina
LEFT JOIN ambientacion a ON a.tipo_ambientacion = o.ambientacion
JOIN barrio b ON b.nombre = o.barrio
JOIN codigo_postal cp ON cp.codigo_postal_argentino = o.codigo_postal_argentino -- O el campo de código postal que uses en tu tabla
JOIN ubicacion u ON u.calle_nombre = o.calle_nombre  AND u.calle_altura = o.calle_altura 
AND u.id_barrio = b.id_barrio;

