CREATE VIEW vista_locales_completo AS
SELECT locall.nombre, horario, categoria.nombre AS categoria, cocina.tipo_cocina
FROM locall
INNER JOIN categoria ON locall.id_categoria = categoria.id_categoria
INNER JOIN cocina ON locall.id_cocina = cocina.id_cocina;

CREATE VIEW vista_locales_ambientacion AS
SELECT locall.nombre, horario, ambientacion.tipo_ambientacion
FROM locall
INNER JOIN ambientacion ON locall.id_ambientacion = ambientacion.id_ambientacion;


CREATE VIEW vista_ubicacion_locales AS
SELECT locall.nombre, calle_nombre, calle_altura, barrio.nombre AS barrio
FROM locall
INNER JOIN ubicacion ON locall.id_ubicacion = ubicacion.id_ubicacion
INNER JOIN barrio ON ubicacion.id_barrio = barrio.id_barrio;

CREATE VIEW vista_contacto_locales AS
SELECT locall.nombre, tipo_contacto, valor
FROM locall
INNER JOIN datos_contacto ON locall.id_local = datos_contacto.id_local;

